{
  "name": "biosonia-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/main.ts",
    "dev:demo": "set PORT=5000&& set DISABLE_DB=true&& set AI_SERVICE_URL=http://localhost:5001&& ts-node-dev --respawn src/main.ts",
    "back": "npm run dev:demo",
    "back:dev": "npm run dev",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "typeorm:run": "ts-node-dev Script/migracion/runner.ts run",
    "typeorm:revert": "ts-node-dev Script/migracion/runner.ts revert"
  },
  "dependencies": {
    "@nestjs/common": "10.3.0",
    "@nestjs/core": "10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "10.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "1.6.2",
    "bcrypt": "5.1.1",
    "dotenv": "16.3.1",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "typeorm": "^0.3.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3"
  }
}
