pipeline {
  agent any
  stages {
    stage('Test Frontend') {
      steps {
        sh 'npm install'
        sh 'cd frontend && npm test --if-present && npm run build'
      }
    }
    stage('Test Backend') {
      steps {
        sh 'npm install'
        sh 'cd backend && npm test --if-present && npm run build'
      }
    }
    stage('Build Docker Images') {
      steps {
        sh 'docker build -f docker/Dockerfile.frontend -t biosonia/frontend:ci .'
        sh 'docker build -f docker/Dockerfile.backend -t biosonia/backend:ci .'
        sh 'docker build -f docker/Dockerfile.ai -t biosonia/ai:ci .'
        sh 'echo "# docker login && docker push ..."'
      }
    }
  }
}