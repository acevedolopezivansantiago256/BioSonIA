generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  files        File[]
  analyses     Analysis[]
}

model File {
  id        String   @id @default(cuid())
  path      String
  mimeType  String
  size      Int
  duration  Float?
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  analysis  Analysis?
  createdAt DateTime @default(now())
}

model AIResult {
  id                  String   @id @default(cuid())
  especie             String
  probabilidad        Float
  top3Json            String?
  espectrogramaBase64 String?
  metadataJson        String?
  analysis            Analysis?
}

model Analysis {
  id         String   @id @default(cuid())
  status     String
  file       File     @relation(fields: [fileId], references: [id])
  fileId     String   @unique
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  aiResult   AIResult? @relation(fields: [aiResultId], references: [id])
  aiResultId String?  @unique
  createdAt  DateTime @default(now())
}